# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# --- Required: MySQL database (used for user auth in app.py) ---
DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database

# --- Required: NewsAPI.org key, used by news_data.py ---
# Get a free key at https://newsapi.org
NEWS_API_KEY=your_newsapi_key
NEWS_API_URL=https://newsapi.org/v2/everything

# --- Optional: World Bank API endpoints (public, no key needed) ---
# gdp.py, inflation_rate.py, and interest_rate.py already have working defaults
# pointing at the real World Bank API for India. Only set these if you want to
# use a different country or a different data source.
# GDP_API_URL=https://api.worldbank.org/v2/country/IN/indicator/NY.GDP.MKTP.CD?format=json&per_page=100
# INFLATION_API_URL=https://api.worldbank.org/v2/country/IN/indicator/FP.CPI.TOTL.ZG?format=json&per_page=100
# INTEREST_RATE_API_URL=https://api.worldbank.org/v2/country/IN/indicator/FR.INR.RINR?format=json&per_page=100
